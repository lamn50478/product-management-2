extends ../../layouts/default.pug

block main
  style.
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,600&family=Inter:wght@300;400;500;600;700&display=swap');

    :root {
      --navy:   #0F172A;
      --blue:   #1E40AF;
      --sky:    #06B6D4;
      --teal:   #0D9488;
      --amber:  #F59E0B;
      --green:  #22C55E;
      --light:  #F8FAFC;
      --border: #E2E8F0;
      --muted:  #64748B;
      --maxw:   1200px;
      --r:      12px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #fff; color: var(--navy); -webkit-font-smoothing: antialiased; }

    /* ── Wrap ── */
    .home-wrap { max-width: var(--maxw); margin: 0 auto; padding: 32px 24px 80px; }

    /* ══ HERO ══ */
    .hero {
      display: grid; grid-template-columns: 1fr 340px;
      gap: 40px; align-items: center;
      background: linear-gradient(135deg, #071029 0%, #0F172A 55%, #1E1B4B 100%);
      color: #fff; padding: 52px 48px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(2,6,23,0.30);
      position: relative; overflow: hidden;
      margin-bottom: 48px;
    }
    .hero::before {
      content: '';
      position: absolute; right: -100px; top: -100px;
      width: 380px; height: 380px; border-radius: 50%;
      background: rgba(6,182,212,0.08);
      pointer-events: none;
    }
    .hero__eyebrow {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--sky);
      margin-bottom: 14px;
    }
    .hero__eyebrow::before {
      content: ''; display: inline-block; width: 20px; height: 2px;
      background: var(--sky); border-radius: 2px;
    }
    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(28px, 4vw, 46px); font-weight: 700;
      line-height: 1.18; margin-bottom: 14px; letter-spacing: -0.02em;
    }
    .hero h1 em { font-style: italic; color: var(--sky); }
    .hero__lead { font-size: 15px; font-weight: 300; color: rgba(255,255,255,0.68); line-height: 1.75; margin-bottom: 28px; max-width: 480px; }
    .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-primary { background: var(--sky); color: #04202a; padding: 11px 22px; border-radius: 10px; font-weight: 700; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
    .btn-primary:hover { background: #22d3ee; transform: translateY(-1px); }
    .btn-outline { background: transparent; color: rgba(255,255,255,0.80); border: 1.5px solid rgba(255,255,255,0.22); padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; text-decoration: none; transition: all 0.2s; }
    .btn-outline:hover { border-color: rgba(255,255,255,0.55); color: #fff; }
    .hero__stats { display: flex; gap: 28px; margin-top: 28px; }
    .hero__stat-val { font-size: 24px; font-weight: 800; color: #fff; line-height: 1; }
    .hero__stat-lbl { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 3px; letter-spacing: 0.04em; }
    .hero__art {
      border-radius: 16px; overflow: hidden;
      box-shadow: 0 20px 48px rgba(0,0,0,0.40);
      aspect-ratio: 4/3;
      background: rgba(255,255,255,0.05);
    }
    .hero__art img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ══ SECTION HEADER ══ */
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px; }
    .sec-head h2 { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--navy); }
    .sec-head a { font-size: 13px; font-weight: 600; color: var(--blue); text-decoration: none; }
    .sec-head a:hover { text-decoration: underline; }

    /* ══ TOPIC CARDS ══ */
    .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 52px; }
    .topic-card {
      border-radius: var(--r); overflow: hidden;
      text-decoration: none; color: inherit;
      background: var(--light); border: 1px solid var(--border);
      display: flex; flex-direction: column;
      transition: box-shadow 0.25s, transform 0.25s;
    }
    .topic-card:hover { box-shadow: 0 12px 40px rgba(15,23,42,0.10); transform: translateY(-3px); }
    .topic-card__thumb {
      aspect-ratio: 16/9; background: #cbd5e1;
      overflow: hidden; position: relative;
    }
    .topic-card__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
    .topic-card:hover .topic-card__thumb img { transform: scale(1.05); }
    .topic-card__thumb-placeholder {
      width: 100%; height: 100%; display: flex;
      align-items: center; justify-content: center;
    }
    .topic-card__body { padding: 18px 20px 20px; flex: 1; display: flex; flex-direction: column; }
    .topic-badge {
      display: inline-block; padding: 4px 12px; border-radius: 20px;
      font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; margin-bottom: 10px;
    }
    .badge--economics { background: #ECFDF5; color: #065F46; }
    .badge--politics  { background: #EFF6FF; color: #1E40AF; }
    .badge--culture   { background: #FFF7ED; color: #92400E; }
    .badge--default   { background: var(--light); color: var(--navy); }
    .topic-card h3 { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 8px; }
    .topic-card p { font-size: 13px; color: var(--muted); line-height: 1.65; flex: 1; margin-bottom: 16px; }
    .topic-card__link {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 13px; font-weight: 600; color: var(--blue);
      text-decoration: none;
    }
    .topic-card__link:hover { text-decoration: underline; }

    /* ══ LATEST EPISODES ══ */
    .ep-list { display: flex; flex-direction: column; gap: 16px; margin-bottom: 52px; }
    .ep-row {
      display: grid; grid-template-columns: 100px 1fr;
      gap: 16px; align-items: start;
      padding: 16px; border-radius: var(--r);
      background: var(--light); border: 1px solid var(--border);
      text-decoration: none; color: inherit;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .ep-row:hover { box-shadow: 0 6px 24px rgba(15,23,42,0.08); transform: translateY(-2px); }
    .ep-thumb {
      width: 100px; height: 100px; border-radius: 10px;
      background: #cbd5e1; overflow: hidden; flex-shrink: 0;
    }
    .ep-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ep-thumb-placeholder {
      width: 100%; height: 100%;
      background: linear-gradient(135deg, var(--navy), var(--blue));
      display: flex; align-items: center; justify-content: center;
    }
    .ep-meta__tags { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; flex-wrap: wrap; }
    .ep-tag {
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; padding: 3px 9px; border-radius: 4px;
    }
    .ep-tag--level { background: #FEF3C7; color: #92400E; }
    .ep-tag--lang  { background: #ECFDF5; color: #065F46; }
    .ep-tag--ep    { background: var(--border); color: var(--muted); }
    .ep-meta h4 { font-size: 15px; font-weight: 700; color: var(--navy); margin-bottom: 5px; line-height: 1.3; }
    .ep-meta h4:hover { color: var(--blue); }
    .ep-desc { font-size: 13px; color: var(--muted); line-height: 1.60; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 8px; }
    .ep-footer { display: flex; align-items: center; gap: 14px; }
    .ep-stat { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted); }
    .ep-play-btn {
      margin-left: auto;
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 16px; border-radius: 8px;
      background: var(--navy); color: #fff;
      font-size: 12px; font-weight: 600;
      text-decoration: none;
      transition: background 0.18s;
    }
    .ep-play-btn:hover { background: var(--blue); }

    /* ══ FEATURES STRIP ══ */
    .features-strip {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0; border: 1px solid var(--border);
      border-radius: 16px; overflow: hidden;
      margin-bottom: 52px;
    }
    .feat-item {
      padding: 28px 24px;
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column; gap: 10px;
    }
    .feat-item:last-child { border-right: none; }
    .feat-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .feat-icon--sky    { background: #ECFEFF; }
    .feat-icon--amber  { background: #FFFBEB; }
    .feat-icon--green  { background: #F0FDF4; }
    .feat-icon--violet { background: #F5F3FF; }
    .feat-item h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin: 0; }
    .feat-item p  { font-size: 12.5px; color: var(--muted); line-height: 1.6; margin: 0; }

    /* ══ QUOTE BANNER ══ */
    .quote-banner {
      background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 100%);
      border-radius: 16px; padding: 40px 48px;
      display: flex; gap: 40px; align-items: center;
      margin-bottom: 52px;
    }
    .quote-banner blockquote {
      font-family: 'Playfair Display', serif;
      font-size: clamp(18px, 2.5vw, 26px); font-style: italic;
      color: #fff; line-height: 1.5; flex: 1;
      border-left: 4px solid var(--sky); padding-left: 24px; margin: 0;
    }
    .quote-banner blockquote cite {
      display: block; font-family: 'Inter', sans-serif;
      font-size: 13px; font-style: normal;
      color: rgba(255,255,255,0.50); margin-top: 12px; font-weight: 500;
    }
    .quote-badge {
      flex-shrink: 0; text-align: center;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 14px; padding: 24px 28px;
    }
    .quote-badge__val { font-size: 36px; font-weight: 800; color: var(--sky); line-height: 1; }
    .quote-badge__lbl { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 4px; }

    /* ══ LEVEL GUIDE ══ */
    .level-guide { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 52px; }
    .lvl-card {
      border-radius: 12px; padding: 20px 18px;
      border: 1.5px solid var(--border);
      transition: border-color 0.2s, box-shadow 0.2s;
      text-decoration: none; color: inherit;
    }
    .lvl-card:hover { border-color: var(--sky); box-shadow: 0 4px 16px rgba(6,182,212,0.12); }
    .lvl-badge {
      display: inline-block; padding: 5px 14px; border-radius: 6px;
      font-size: 14px; font-weight: 800; letter-spacing: 0.06em;
      text-transform: uppercase; margin-bottom: 10px;
    }
    .lvl-badge--a1 { background: #ECFDF5; color: #065F46; }
    .lvl-badge--a2 { background: #EFF6FF; color: #1E40AF; }
    .lvl-badge--b1 { background: #FFF7ED; color: #92400E; }
    .lvl-badge--b2 { background: #FDF4FF; color: #7E22CE; }
    .lvl-card h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 5px; }
    .lvl-card p  { font-size: 12.5px; color: var(--muted); line-height: 1.6; margin: 0; }

    footer.site-footer { text-align: center; padding: 20px 0; color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; padding: 36px 28px; }
      .hero__art { display: none; }
      .topic-grid { grid-template-columns: 1fr; }
      .features-strip { grid-template-columns: 1fr 1fr; }
      .level-guide { grid-template-columns: 1fr 1fr; }
      .quote-banner { flex-direction: column; padding: 28px; }
    }

    @media (max-width: 640px) {
      .home-wrap { padding: 16px 14px 60px; }

      /* Hero */
      .hero { padding: 28px 20px; border-radius: 14px; margin-bottom: 28px; }
      .hero h1 { font-size: 28px; }
      .hero__lead { font-size: 14px; margin-bottom: 20px; }
      .hero__cta { flex-direction: column; gap: 10px; }
      .btn-primary, .btn-outline { width: 100%; justify-content: center; }
      .hero__stats { gap: 18px; margin-top: 20px; }
      .hero__stat-val { font-size: 20px; }

      /* Section headers */
      .sec-head { margin-bottom: 14px; }
      .sec-head h2 { font-size: 18px; }

      /* Features strip */
      .features-strip {
        grid-template-columns: 1fr;
        border-radius: 12px;
        margin-bottom: 32px;
      }
      .feat-item {
        border-right: none;
        border-bottom: 1px solid var(--border);
        padding: 18px 16px;
        flex-direction: row; gap: 14px; align-items: flex-start;
      }
      .feat-item:last-child { border-bottom: none; }
      .feat-icon { flex-shrink: 0; }

      /* Topic cards */
      .topic-grid { grid-template-columns: 1fr; gap: 14px; margin-bottom: 32px; }
      .topic-card__thumb { aspect-ratio: 16/7; }

      /* Episodes */
      .ep-list { gap: 12px; margin-bottom: 32px; }
      .ep-row { grid-template-columns: 80px 1fr; gap: 12px; padding: 12px; }
      .ep-thumb { width: 80px; height: 80px; border-radius: 8px; }
      .ep-meta h4 { font-size: 14px; }
      .ep-desc { -webkit-line-clamp: 1; }
      .ep-play-btn { padding: 6px 12px; font-size: 11px; }
      .ep-footer { flex-wrap: wrap; gap: 8px; }

      /* Quote banner */
      .quote-banner { padding: 22px 18px; gap: 20px; border-radius: 12px; margin-bottom: 32px; }
      .quote-banner blockquote { font-size: 16px; padding-left: 16px; }
      .quote-badge { width: 100%; }

      /* Level guide */
      .level-guide { grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 32px; }
      .lvl-card { padding: 14px 12px; border-radius: 10px; }
      .lvl-badge { font-size: 13px; padding: 4px 10px; }
      .lvl-card h4 { font-size: 13px; }
      .lvl-card p { font-size: 11.5px; }
    }

  .home-wrap

    //- ══ HERO ══
    section.hero
      div
        p.hero__eyebrow Audio Series
        h1
          | English Podcast
          br
          em Hub
        p.hero__lead Luyện nghe tiếng Anh mỗi ngày qua những podcast chọn lọc theo cấp độ và chủ đề. Mỗi episode kèm transcript đồng bộ.
        .hero__cta
          a.btn-primary(href='/products')
            svg(width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round')
              polygon(points='5 3 19 12 5 21 5 3')
            | Nghe ngay
          a.btn-outline(href='/products') Xem tất cả
        .hero__stats
          div
            .hero__stat-val A1–B2
            .hero__stat-lbl Cấp độ
          div
            .hero__stat-val 100%
            .hero__stat-lbl Tiếng Anh
          div
            .hero__stat-val Free
            .hero__stat-lbl Truy cập
      .hero__art
        img(src='/uploads/anhPodcast.avif' alt='Podcast hero' onerror="this.style.display='none'")

    //- ══ FEATURES STRIP ══
    .features-strip
      .feat-item
        .feat-icon.feat-icon--sky
          svg(width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#06B6D4' stroke-width='2' stroke-linecap='round')
            path(d='M9 18V5l12-2v13')
            circle(cx='6' cy='18' r='3')
            circle(cx='18' cy='16' r='3')
        h4 Nghe podcast
        p Audio chất lượng cao, stream mượt mà ngay lập tức
      .feat-item
        .feat-icon.feat-icon--amber
          svg(width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#F59E0B' stroke-width='2' stroke-linecap='round')
            path(d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z')
            polyline(points='14 2 14 8 20 8')
            line(x1='16' y1='13' x2='8' y2='13')
            line(x1='16' y1='17' x2='8' y2='17')
        h4 Transcript
        p Đồng bộ chữ với audio theo từng giây
      .feat-item
        .feat-icon.feat-icon--green
          svg(width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#22C55E' stroke-width='2' stroke-linecap='round')
            path(d='M22 11.08V12a10 10 0 1 1-5.93-9.14')
            polyline(points='22 4 12 14.01 9 11.01')
        h4 Phân cấp A1–B2
        p Mỗi episode gắn cấp độ, lọc theo trình độ của bạn
      .feat-item
        .feat-icon.feat-icon--violet
          svg(width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#7C3AED' stroke-width='2' stroke-linecap='round')
            rect(x='3' y='11' width='18' height='11' rx='2' ry='2')
            path(d='M7 11V7a5 5 0 0 1 10 0v4')
        h4 Nội dung bảo mật
        p Audio được mã hóa Signed URL, không lộ link gốc

    //- ══ TOPIC CARDS ══
    .sec-head
      h2 Chủ đề nổi bật
      a(href='/products') Xem tất cả →
    .topic-grid
      //- Economics
      a.topic-card(href='/products/category/kinh-te')
        .topic-card__thumb
          img(src='/img/PEP_Talk.jpg' alt='Economics')
        .topic-card__body
          span.topic-badge.badge--economics Economics
          h3 The Economics of Everyday Life
          p Chủ đề kinh tế qua ngôn ngữ đơn giản — lạm phát, thị trường, tài chính cá nhân.
          span.topic-card__link
            | Khám phá
            svg(width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round')
              line(x1='5' y1='12' x2='19' y2='12')
              polyline(points='12 5 19 12 12 19')

      //- Politics
      a.topic-card(href='/products/category/chinh-tri')
        .topic-card__thumb
          img(src='/img/politics.jpg' alt='Politics')
        .topic-card__body
          span.topic-badge.badge--politics Politics
          h3 Understanding Global Policy
          p Chính sách thế giới được giải thích bằng tiếng Anh đơn giản bởi các chuyên gia.
          span.topic-card__link
            | Khám phá
            svg(width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round')
              line(x1='5' y1='12' x2='19' y2='12')
              polyline(points='12 5 19 12 12 19')

      //- Culture
      a.topic-card(href='/products/category/van-hoa')
        .topic-card__thumb
          img(src='/img/culture.jpg' alt='Culture')
        .topic-card__body
          span.topic-badge.badge--culture Culture
          h3 Stories and Traditions
          p Câu chuyện văn hóa giúp mở rộng từ vựng và hiểu ngữ cảnh sử dụng tiếng Anh.
          span.topic-card__link
            | Khám phá
            svg(width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round')
              line(x1='5' y1='12' x2='19' y2='12')
              polyline(points='12 5 19 12 12 19')

    //- ══ LATEST EPISODES ══
    .sec-head
      h2 Episodes mới nhất
      a(href='/products') Xem thêm →
    .ep-list
      if products && products.length > 0
        - let idx = 0
        each product in products
          - let delay = idx++ * 0.06
          a.ep-row(href=`/products/detail/${product.slug}` style=`animation: fadeUp 0.4s ease ${delay}s both`)
            .ep-thumb
              if product.thumbnail
                img(src=product.thumbnail alt=product.title loading='lazy')
              else
                .ep-thumb-placeholder
                  svg(width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='rgba(255,255,255,0.35)' stroke-width='1.2' stroke-linecap='round')
                    path(d='M9 18V5l12-2v13')
                    circle(cx='6' cy='18' r='3')
                    circle(cx='18' cy='16' r='3')
            .ep-meta
              .ep-meta__tags
                if product.episodeNumber
                  span.ep-tag.ep-tag--ep EP #{product.episodeNumber}
                if product.level
                  span.ep-tag.ep-tag--level #{product.level}
                if product.language
                  span.ep-tag.ep-tag--lang #{product.language.toUpperCase()}
              h4 #{product.title}
              if product.description
                .ep-desc !{product.description}
              .ep-footer
                if product.duration
                  .ep-stat
                    svg(width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
                      circle(cx='12' cy='12' r='10')
                      polyline(points='12 6 12 12 16 14')
                    span #{Math.floor(product.duration/60)}:#{String(product.duration%60).padStart(2,'0')} phút
                if product.playCount
                  .ep-stat
                    svg(width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
                      path(d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z')
                      circle(cx='12' cy='12' r='3')
                    span #{product.playCount.toLocaleString('vi-VN')}
                span.ep-play-btn
                  svg(width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round')
                    polygon(points='5 3 19 12 5 21 5 3')
                  | Nghe ngay
      else
        p(style='color: var(--muted); text-align: center; padding: 40px') Chưa có episode nào.

    //- ══ QUOTE BANNER ══
    .quote-banner
