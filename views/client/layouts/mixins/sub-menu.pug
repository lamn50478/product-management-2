//- mixin sub-menu(items, path)
//-   ul.submenu
//-     each item in items
//-       li
//-         a(href=`${path}/category/${item.slug}`) #{item.title}
//-         if item.children && item.children.length > 0
//-           +sub-menu(item.children, path)
mixin sub-menu(items, path)
  ul.submenu
    each item in items
      li
        a(href=`${path}/category/${item.slug}`)
          //- Icon theo slug
          if item.slug === 'chinh-tri'
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
              circle(cx="12" cy="12" r="10")
              line(x1="2" y1="12" x2="22" y2="12")
              path(d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z")
          else if item.slug === 'van-hoa'
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
              path(d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z")
          else if item.slug === 'kinh-te'
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
              line(x1="12" y1="20" x2="12" y2="10")
              line(x1="18" y1="20" x2="18" y2="4")
              line(x1="6" y1="20" x2="6" y2="16")
          else
            //- Icon mặc định cho các danh mục khác
            svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
              path(d="M9 18V5l12-2v13")
              circle(cx="6" cy="18" r="3")
              circle(cx="18" cy="16" r="3")
          | #{item.title}
        if item.children && item.children.length > 0
          +sub-menu(item.children, path)
