mixin select-tree(items, level = 1, selectedId = '')
  - const pad = Array(level).fill('-- ').join('')
  each item in items
    - const nodeId = (item._id ? item._id.toString() : (item.id ? item.id.toString() : ''))
    option(
      value=nodeId
      selected=(selectedId && selectedId.toString && selectedId.toString() === nodeId ? true : false)
    ) #{pad}#{item.title}
    if item.children && item.children.length
      +select-tree(item.children, level + 1, selectedId)
