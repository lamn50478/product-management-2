extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug

block main
  +alert-success(5000)
  +alert-error(5000)
  h1.mb-4 Thêm mới sản phẩm

  form#form-create-product(method="POST" action=`${prefixAdmin}/products/create` enctype="multipart/form-data")
    .row
      .col-md-8
        .form-group
          label(for="title") Tiêu đề
          input#title.form-control(name="title" type="text" required placeholder="Tên file / tiêu đề" value=(typeof product !== 'undefined' && product.title ? product.title : ''))

        .form-group
          label(for="product_category_id") --Danh mục --
          select#product_category_id.form-control(name="product_category_id")
            option(value="") Chọn danh mục
            if category
              +select-tree(category,1, (typeof product !== 'undefined' ? product.product_category_id : null))

        .form-group
          label(for="description") Mô tả
          textarea#description.form-control(name="description" rows="4") #{typeof product !== 'undefined' && product.description ? product.description : ''}

        .form-group
          label(for="level") Trình độ
          select#level.form-control(name="level")
            option(value="") --Chọn--
            option(value="A1" selected=(typeof product !== 'undefined' && product.level === 'A1')) A1
            option(value="A2" selected=(typeof product !== 'undefined' && product.level === 'A2')) A2
            option(value="B1" selected=(typeof product !== 'undefined' && product.level === 'B1')) B1
            option(value="B2" selected=(typeof product !== 'undefined' && product.level === 'B2')) B2

        .form-group
          label(for="file") Chọn file audio
          input#file.form-control-file(type="file" name="file" accept="audio/*" required)
          small.form-text.text-muted Max 200MB; định dạng mp3, wav, ogg

        .form-group
          audio#previewAudio(controls style="width:100%; display:none")
            source(src="" type="audio/mpeg")
        .form-group
          div#waveform(style="height:80px; display:none")

        .form-group
          label(for="transcript") Transcript (tùy chọn)
          textarea#transcript.form-control(name="transcript" rows="6") #{typeof product !== 'undefined' && product.transcript ? product.transcript : ''}

      .col-md-4
        .card
          .card-body
            .form-group
              label(for="thumbnail") Ảnh bìa
              input#thumbnail.form-control-file(type="file" name="thumbnail" accept="image/*")
              .mt-2
              - var thumbSrc = (typeof product !== 'undefined' && product.thumbnail) ? product.thumbnail : '/images/default-thumb.png'
              img#thumbPreview(src=thumbSrc style="width:100%; height:auto; display:block; border-radius:4px")

            

            .form-group
              label(for="position") Vị trí
              input#position.form-control(type="number" name="position" placeholder="Tự động tăng" min=0 value=(typeof product !== 'undefined' && product.position ? product.position : 0))

            .form-group
              label Trạng thái
              .form-check
                input.form-check-input(type="radio" name="status" id="statusActive" value="active" checked=(typeof product === 'undefined' || product.status === 'active'))
                label.form-check-label(for="statusActive") Hoạt động
              .form-check
                input.form-check-input(type="radio" name="status" id="statusInactive" value="inactive" checked=(typeof product !== 'undefined' && product.status === 'inactive'))
                label.form-check-label(for="statusInactive") Dừng Hoạt động

            .form-group.mt-3
              button.btn.btn-outline-primary(type="submit") Thêm mới
              a.btn.btn-secondary.ml-2(href=`${prefixAdmin}/products`) Hủy

  script(src="https://unpkg.com/wavesurfer.js")
  script.
    (function(){
      const fileInput = document.getElementById('file');
      const audioEl = document.getElementById('previewAudio');
      const waveformEl = document.getElementById('waveform');
      let wavesurfer = null;

      if (fileInput) {
        fileInput.addEventListener('change', function(e){
          const file = e.target.files[0];
          if (!file) {
            if (audioEl) { audioEl.style.display = 'none'; audioEl.querySelector('source').src = ''; audioEl.load(); }
            if (waveformEl) waveformEl.style.display = 'none';
            if (wavesurfer) { wavesurfer.destroy(); wavesurfer = null; }
            return;
          }

          const url = URL.createObjectURL(file);

          if (audioEl) {
            audioEl.style.display = 'block';
            audioEl.querySelector('source').src = url;
            audioEl.load();
          }

          if (waveformEl) {
            waveformEl.style.display = 'block';
            if (wavesurfer) { wavesurfer.destroy(); wavesurfer = null; }
            try {
              wavesurfer = WaveSurfer.create({
                container: '#waveform',
                waveColor: '#97c2ff',
                progressColor: '#2b8cff',
                height: 60,
                responsive: true
              });
              wavesurfer.load(url);
            } catch (err) {
              console.warn('WaveSurfer init failed', err);
            }
          }
        });
      }

      const thumbInput = document.getElementById('thumbnail');
      const thumbPreview = document.getElementById('thumbPreview');
      thumbInput && thumbInput.addEventListener('change', function(e){
        const f = e.target.files[0];
        if (!f) return;
        const u = URL.createObjectURL(f);
        thumbPreview.src = u;
      });

      const form = document.getElementById('form-create-product');
      form && form.addEventListener('submit', function(e){
        const title = document.getElementById('title').value.trim();
        if (!title) { e.preventDefault(); alert('Vui lòng nhập tiêu đề'); return false; }
        const file = document.getElementById('file').files[0];
        if (!file) { e.preventDefault(); alert('Vui lòng chọn file audio'); return false; }
      });
    })();

  script(src="/admin/js/product.js")
