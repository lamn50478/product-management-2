  +alert-error(4000)

  .podcast-card
    .podcast-header
      h1.podcast-title #{product && product.title ? product.title : 'Không có tiêu đề'}
    .podcast-body
      // LEFT COLUMN (redesigned, non-interactive badge to avoid duplicate play control)
      .left-col
        - var thumbSrc = product && product.thumbnail ? product.thumbnail : '/images/default-thumb.png'
        .thumb-wrap
          img.thumb(src=thumbSrc alt=(product && product.title ? product.title : 'thumbnail') loading="lazy")
          if product && product.audioUrl
            // decorative badge only (non-interactive) to indicate audio exists
            
        header.left-meta
          // improved title: accent first word for visual pop
          - var niceTitle = product && product.title ? product.title : 'Không có tiêu đề'
          - var firstWord = (niceTitle || '').split(' ')[0] || ''
          - var restTitle = (niceTitle || '').split(' ').slice(1).join(' ')
          h2.podcast-title-left(itemprop="name")
            if restTitle
              span.accent #{firstWord}
              |  #{' ' + restTitle}
            else
              | #{niceTitle}
          p.podcast-submeta
            if product && product.author
              span.author #{product.author}
            if product && product.publishedAt
              time.pubdate(datetime=product.publishedAt) #{new Date(product.publishedAt).toLocaleDateString()}
        .meta
          .meta-item.meta-id(role="group" aria-label="Episode ID")
            .meta-left
              span.meta-label ID
              span.meta-desc Mã tập
            .meta-right
              span.value#episodeId #{product && product._id ? product._id : '-'}
              button.copy-id(type="button" title="Sao chép ID" aria-label="Copy ID") Sao chép
          .meta-item.meta-level
            .meta-left
              span.meta-label Level
              span.meta-desc Độ khó / cấp độ
            .meta-right
              if product && product.level
                span.badge-level #{product.level}
              else
                span.value -
          .meta-item.meta-category
            .meta-left
              span.meta-label Chủ đề
              span.meta-desc Thể loại
            .meta-right
              if product && product.categoryName
                a.category-link(href=`/admin/products?category=${encodeURIComponent(product.categoryName)}` title=`Xem tất cả ${product.categoryName}`) #{product.categoryName}
              else
                span.value -


        // Structured data for SEO
        if product
          script(type="application/ld+json").
            {
              "@context": "https://schema.org",
              "@type": "PodcastEpisode",
              "name": "#{product && product.title ? product.title.replace(/"/g, '\\"') : ''}",
              "description": "#{(product && product.description) ? product.description.replace(/"/g, '\\"').replace(/\n/g, ' ') : ''}",
              "url": "#{product && product.audioUrl ? product.audioUrl : ''}",
              "datePublished": "#{product && product.publishedAt ? product.publishedAt : ''}",
              "identifier": "#{product && product._id ? product._id : ''}"
            }

      // RIGHT COLUMN (single play control remains here)
      .right-col
        .wave-overlay
          #waveform

        .subtitle-overlay(id="subtitleOverlay")

        .player-controls
          button.btn.btn-play(type="button" id="playPauseBtn" aria-label="Play/Pause") ▶
          button.btn.btn-secondary(type="button" id="rewind30") -30s
          button.btn.btn-secondary(type="button" id="forward30") +30s
          .time
            span#currentTime 00:00
            |  /
            span#totalTime 00:00
          .volume
            input(type="range" id="volumeRange" min="0" max="1" step="0.01" value="1")
          .actions
            if product && product.audioUrl
              a.btn.btn-secondary(href=product.audioUrl download) Tải xuống
            a.btn.btn-secondary(href=`${prefixAdmin}/products`) Quay lại

        .progress-mini
          .bar(id="miniBar")

        h3 Transcript
        .transcript-container(id="transcriptContainer")
          if transcript && transcript.length
            each seg, i in transcript
              p.transcript-line(id=`seg-${i}` data-start=seg.start data-end=seg.end)= seg.text

        .transcript-controls(style="margin-top:8px; display:flex; gap:8px; align-items:center;")
          button.btn.btn-secondary(type="button" id="copyTranscript") Sao chép transcript
          button.btn.btn-secondary(type="button" id="startTranscribeBtn") Tạo transcript
          span#transcribeStatus(style="margin-left:8px; color:#6b7280; font-weight:600;")

        if product && product.description
          p.description !{product.description}
        else
          p.description.text-muted Chưa có mô tả

  // Use a specific Wavesurfer version
  script(src="https://unpkg.com/wavesurfer.js@6.1.0/dist/wavesurfer.min.js")

  // Client script: waveform, transcript render, transcribe polling, plus copy-id
  script.
    (function(){
      // --- helpers
      function fmt(sec){ if (!isFinite(sec)) return '00:00'; const m = Math.floor(sec/60).toString().padStart(2,'0'); const s = Math.floor(sec%60).toString().padStart(2,'0'); return m + ':' + s; }

      const playBtn = document.getElementById('playPauseBtn');
      const currentTimeEl = document.getElementById('currentTime');
      const totalTimeEl = document.getElementById('totalTime');
      const miniBar = document.getElementById('miniBar');
      const volumeRange = document.getElementById('volumeRange');
      const transcriptContainer = document.getElementById('transcriptContainer');
      const rewindBtn = document.getElementById('rewind30');
      const forwardBtn = document.getElementById('forward30');
      const subtitleOverlay = document.getElementById('subtitleOverlay');
      const copyBtn = document.getElementById('copyTranscript');
      const startTranscribeBtn = document.getElementById('startTranscribeBtn');
      const transcribeStatus = document.getElementById('transcribeStatus');

      const audioUrl = !{JSON.stringify(product && product.audioUrl ? product.audioUrl : null)};
      const rawTranscript = !{JSON.stringify(transcript ? transcript : null)};

      if (!audioUrl) {
        if (playBtn) playBtn.disabled = true;
        if (volumeRange) volumeRange.disabled = true;
        return;
      }

      // Create WaveSurfer (WebAudio backend)
      let wavesurfer = null;
      try {
        wavesurfer = WaveSurfer.create({
          container: '#waveform',
          backend: 'WebAudio',
          waveColor: '#dbeafe',
          progressColor: '#0ea5e9',
          cursorColor: '#0f172a',
          height: 140,
          barWidth: 2,
          normalize: true,
          responsive: true
        });
      } catch (e) {
        console.error('WaveSurfer create error:', e);
      }
      if (!wavesurfer) return;

      // Load audio URL (WaveSurfer will fetch and decode)
      wavesurfer.load(audioUrl);

      // UI enable on ready
      wavesurfer.on('ready', function(){
        totalTimeEl.textContent = fmt(wavesurfer.getDuration() || 0);
        wavesurfer.setVolume(parseFloat(volumeRange.value));
        if (playBtn) playBtn.disabled = false;
        if (volumeRange) volumeRange.disabled = false;
      });

      wavesurfer.on('error', (e) => console.warn('wavesurfer error:', e));
      wavesurfer.on('loading', (pct) => console.log('wavesurfer loading:', pct));

      // Play/pause
      function togglePlayPause(){
        try {
          if (wavesurfer.isPlaying()) wavesurfer.pause();
          else wavesurfer.play();
        } catch (e) {
          console.warn('Play/pause fallback error:', e);
        }
      }

      if (playBtn) {
        playBtn.addEventListener('click', togglePlayPause);
      }

      wavesurfer.on('play', function(){ if (playBtn) playBtn.textContent = '❚❚'; });
      wavesurfer.on('pause', function(){ if (playBtn) playBtn.textContent = '▶'; });
      wavesurfer.on('finish', function(){ if (playBtn) playBtn.textContent = '▶'; wavesurfer.seekTo(0); });

      // Update mini progress and time
      wavesurfer.on('audioprocess', function(time){
        const dur = wavesurfer.getDuration() || 1;
        currentTimeEl.textContent = fmt(time);
        miniBar.style.width = (Math.max(0, Math.min(1, time/dur)) * 100) + '%';
      });

      // Volume
      if (volumeRange) {
        volumeRange.addEventListener('input', function(){
          const v = parseFloat(this.value);
          wavesurfer.setVolume(v);
        });
      }

      // Mini progress click -> seek
      const miniWrap = document.querySelector('.progress-mini');
      if (miniWrap) {
        miniWrap.addEventListener('click', function(e){
          const rect = miniWrap.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const pct = Math.max(0, Math.min(1, x / rect.width));
          wavesurfer.seekTo(pct);
        });
      }

      // ---------- Transcript render & sync ----------
      function buildTranscriptSegments(raw){
        if (!raw) return [];
        if (Array.isArray(raw)) return raw.map(s=>({ start: Number(s.start), end: s.end!=null?Number(s.end):null, text: s.text||'' }));
        if (typeof raw === 'string') {
          try { const parsed = JSON.parse(raw); if (Array.isArray(parsed)) return parsed.map(s=>({ start: Number(s.start), end: s.end!=null?Number(s.end):null, text: s.text||'' })); } catch(e){}
        }
        return [];
      }

      // Expose render/rebuild to global so polling code can call them
      window.renderTranscript = function(segs){
        if (!transcriptContainer) return;
        transcriptContainer.innerHTML = '';
        segs.forEach((s, idx)=> {
          const p = document.createElement('p');
          p.className = 'transcript-line';
          p.id = 'seg-' + idx;
          p.dataset.start = s.start;
          if (s.end != null) p.dataset.end = s.end;
          p.textContent = s.text || '';
          transcriptContainer.appendChild(p);
        });
      };

      window.rebuildLines = function(){
        window._lines = Array.from(transcriptContainer ? transcriptContainer.querySelectorAll('.transcript-line') : []).map(el=>({ el, start: Number(el.dataset.start||0), end: el.dataset.end!=null?Number(el.dataset.end):null }));
      };

      // initial render
      const segments = buildTranscriptSegments(rawTranscript);
      window.renderTranscript(segments);
      window.rebuildLines();

      // highlight logic
      window._currentIndex = -1;
      function highlightIndex(idx){
        if (window._currentIndex === idx) return;
        if (window._currentIndex >= 0 && window._lines && window._lines[window._currentIndex]) window._lines[window._currentIndex].el.classList.remove('active-transcript');
        window._currentIndex = idx;
        if (window._currentIndex >= 0 && window._lines && window._lines[window._currentIndex]) {
          const el = window._lines[window._currentIndex].el;
          el.classList.add('active-transcript');
          if (subtitleOverlay) subtitleOverlay.textContent = el.textContent || '';
          if (transcriptContainer) {
            const rect = el.getBoundingClientRect();
            const parentRect = transcriptContainer.getBoundingClientRect();
            const offset = rect.top - parentRect.top - parentRect.height/2 + rect.height/2;
            transcriptContainer.scrollTop += offset;
          }
        } else {
          if (subtitleOverlay) subtitleOverlay.textContent = '';
        }
      }

      // sync on audioprocess
      wavesurfer.on('audioprocess', function(){
        const t = wavesurfer.getCurrentTime() || 0;
        let found = -1;
        const lines = window._lines || [];
        for (let i=0;i<lines.length;i++){
          const s = lines[i];
          const end = s.end != null ? s.end : (i+1<lines.length ? lines[i+1].start : Infinity);
          if (t >= s.start && t < end) { found = i; break; }
        }
        highlightIndex(found);
      });

      // click to seek
      transcriptContainer && transcriptContainer.addEventListener('click', function(e){
        const el = e.target.closest('.transcript-line');
        if (!el) return;
        const start = Number(el.dataset.start || 0);
        const dur = wavesurfer.getDuration() || 1;
        wavesurfer.seekTo(Math.max(0, Math.min(1, start / dur)));
        setTimeout(()=> { window.rebuildLines(); const idx = Array.prototype.indexOf.call(transcriptContainer.querySelectorAll('.transcript-line'), el); highlightIndex(idx); }, 50);
      });

      // TTS toggle (if present)
      let ttsEnabled = false;
      let utterance = null;
      const ttsToggle = document.getElementById('ttsToggle');
      if (ttsToggle) {
        ttsToggle.addEventListener('click', () => {
          ttsEnabled = !ttsEnabled;
          ttsToggle.textContent = ttsEnabled ? 'Tắt đọc' : 'Bật đọc';
          if (!ttsEnabled && speechSynthesis && utterance) { speechSynthesis.cancel(); utterance = null; }
        });
      }
      function maybeSpeak(idx){
        if (!ttsEnabled) return;
        if (idx >= 0 && window._lines && window._lines[idx]) {
          const text = window._lines[idx].el.textContent.trim();
          if (speechSynthesis) {
            speechSynthesis.cancel();
            utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 1.0;
            speechSynthesis.speak(utterance);
          }
        }
      }
      // wrap highlightIndex to speak
      const _origHighlight = highlightIndex;
      highlightIndex = function(idx){ _origHighlight(idx); maybeSpeak(idx); };

      // copy transcript
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const text = (window._lines || []).map(l => l.el.textContent).join('\n');
          navigator.clipboard && navigator.clipboard.writeText(text).then(()=> {
            const old = copyBtn.textContent;
            copyBtn.textContent = 'Đã sao chép';
            setTimeout(()=> copyBtn.textContent = old, 1500);
          }).catch(()=> alert('Không thể sao chép tự động. Vui lòng copy thủ công.'));
        });
      }

      // ±30s
      function seekToTimeOffset(offset){ const dur = wavesurfer.getDuration() || 1; const cur = wavesurfer.getCurrentTime() || 0; const target = Math.max(0, Math.min(dur, cur + offset)); wavesurfer.seekTo(target / dur); }
      rewindBtn && rewindBtn.addEventListener('click', ()=> seekToTimeOffset(-30));
      forwardBtn && forwardBtn.addEventListener('click', ()=> seekToTimeOffset(30));

      // ---------- Robust fetchJson helper ----------
      async function fetchJson(url, opts = {}) {
        const defaultHeaders = { 'Accept': 'application/json' };
        const finalOpts = Object.assign({ credentials: 'same-origin', headers: {} }, opts);
        finalOpts.headers = Object.assign({}, defaultHeaders, finalOpts.headers || {});
        const resp = await fetch(url, finalOpts);
        const ct = resp.headers.get('content-type') || '';
        if (!resp.ok) {
          if (ct.includes('application/json')) {
            const err = await resp.json();
            throw new Error(err && err.message ? err.message : JSON.stringify(err));
          } else {
            const text = await resp.text();
            throw new Error(`HTTP ${resp.status}: ${text.slice(0,200)}`);
          }
        }
        if (ct.includes('application/json')) return resp.json();
        const text = await resp.text();
        throw new Error('Expected JSON but got: ' + text.slice(0,200));
      }

      // ---------- Transcription (AssemblyAI) polling (FE calls BE endpoints) ----------
      function productBasePath(){
        const p = window.location.pathname;
        return p;
      }

      if (startTranscribeBtn) {
        startTranscribeBtn.addEventListener('click', async () => {
          startTranscribeBtn.disabled = true;
          transcribeStatus.textContent = 'Gửi yêu cầu tạo transcript...';
          try {
            const createJson = await fetchJson(`${productBasePath()}/transcribe`, { method: 'POST' });
            if (!createJson.success) throw new Error(createJson.message || 'Create job failed');
            const transcriptId = createJson.transcriptId;
            transcribeStatus.textContent = 'Đã gửi. Đang chờ xử lý...';

            let finished = false;
            let tries = 0;
            while (!finished && tries < 90) {
              await new Promise(r => setTimeout(r, 2000));
              tries++;
              const statusJson = await fetchJson(`${productBasePath()}/transcribe-status/${transcriptId}`);
              if (!statusJson.success) throw new Error('Status check failed');
              const s = statusJson.data;
              if (s.status === 'completed') {
                finished = true;
                transcribeStatus.textContent = 'Hoàn tất. Lưu transcript...';
                const saveJson = await fetchJson(`${productBasePath()}/save-transcript`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ transcriptId })
                });
                if (!saveJson.success) throw new Error('Save transcript failed');
                if (saveJson.segments && Array.isArray(saveJson.segments)) {
                  window.renderTranscript(saveJson.segments);
                  window.rebuildLines();
                } else {
                  location.reload();
                }
                transcribeStatus.textContent = 'Đã lưu transcript';
                break;
              } else if (s.status === 'processing') {
                transcribeStatus.textContent = 'Đang xử lý...';
              } else if (s.status === 'error') {
                throw new Error(s.error || 'Transcription error');
              }
            }
            if (!finished) transcribeStatus.textContent = 'Quá thời gian chờ. Vui lòng thử lại.';
          } catch (err) {
            console.error(err);
            transcribeStatus.textContent = 'Lỗi: ' + (err.message || 'Không thể tạo transcript');
          } finally {
            startTranscribeBtn.disabled = false;
          }
        });
      }

      // Copy episode ID button (left column)
      (function(){
        const copyBtn = document.querySelector('.copy-id');
        const idEl = document.getElementById('episodeId');
        if (copyBtn && idEl) {
          copyBtn.addEventListener('click', function(){
            const text = idEl.textContent.trim();
            if (!text || text === '-') return;
            navigator.clipboard && navigator.clipboard.writeText(text).then(()=> {
              const old = copyBtn.textContent;
              copyBtn.textContent = 'Đã sao chép';
              setTimeout(()=> copyBtn.textContent = old, 1400);
            }).catch(()=> {
              alert('Không thể sao chép tự động. Vui lòng copy thủ công: ' + text);
            });
          });
        }
      })();

    })();
