extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  style.
    .podcast-card { max-width:1100px; margin:28px auto; border-radius:12px; overflow:hidden; background:#fff; box-shadow:0 10px 30px rgba(15,23,42,0.06); border:1px solid #eef2f7; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial; }
    .podcast-header { padding:18px 22px; border-bottom:1px solid #f1f5f9; background:linear-gradient(90deg,#fbfdff 0%,#fff 100%); }
    .podcast-title { margin:0; font-size:1.5rem; color:#0f172a; font-weight:700; }
    .podcast-body { display:flex; gap:24px; padding:20px; align-items:flex-start; flex-wrap:wrap; }
    /* LEFT COL (new) */
    .left-col { flex:0 0 340px; display:flex; flex-direction:column; gap:14px; align-items:stretch; }
    .thumb-wrap { border-radius:12px; overflow:hidden; border:1px solid #e6eef8; background:linear-gradient(180deg,#f8fafc,#fff); position:relative; }
    .thumb { width:100%; max-width:320px; height:320px; object-fit:cover; border-radius:0; transition:transform .18s ease,box-shadow .18s ease; display:block; }
    .play-badge { position:absolute; right:12px; bottom:12px; display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; background:linear-gradient(180deg,#0f172a,#0b1220); color:#fff; border-radius:14px; font-weight:800; border:2px solid rgba(255,255,255,0.06); box-shadow:0 8px 20px rgba(15,23,42,0.12); pointer-events:none; }
    .play-badge .icon { font-size:1.05rem; transform:translateX(1px); }
    .left-meta { padding:12px 8px; }
    .podcast-title-left { margin:6px 0 6px; font-size:1.25rem; color:#0f172a; font-weight:900; line-height:1.12; letter-spacing:-0.2px; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .podcast-title-left .accent { background:linear-gradient(90deg,#06b6d4,#3b82f6); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .podcast-submeta { margin:0; color:#6b7280; font-weight:600; font-size:0.9rem; display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .meta { display:flex; flex-direction:column; gap:10px; }
    .meta-item { display:flex; justify-content:space-between; align-items:center; padding:12px; border-radius:10px; background:linear-gradient(90deg,#fbfdff,#fff); border:1px solid #eef2f7; }
    .meta-left { display:flex; flex-direction:column; gap:4px; }
    .meta-label { font-weight:700; color:#0f172a; font-size:0.92rem; }
    .meta-desc { font-size:0.78rem; color:#6b7280; font-weight:600; }
    .meta-right { display:flex; gap:8px; align-items:center; }
    .badge-level { background:linear-gradient(90deg,#06b6d4,#3b82f6); color:#fff; padding:6px 10px; border-radius:999px; font-weight:800; font-size:0.85rem; box-shadow:0 6px 18px rgba(59,130,246,0.08); }
    .category-link { color:#0ea5e9; font-weight:700; text-decoration:none; }
    .copy-id { font-size:0.82rem; padding:6px 8px; border-radius:8px; background:#f8fafc; border:1px solid #e6eef8; cursor:pointer; }
    .visually-hidden { position:absolute !important; height:1px; width:1px; overflow:hidden; clip:rect(1px,1px,1px,1px); white-space:nowrap; border:0; padding:0; margin:-1px; }
    /* RIGHT COL (existing) */
    .right-col { flex:1 1 520px; display:flex; flex-direction:column; gap:14px; }
    #waveform { width:100%; height:140px; border-radius:8px; overflow:hidden; background:linear-gradient(180deg,#f8fbff,#fff); border:1px solid #eef2f7; display:block; }
    .subtitle-overlay { margin-top:8px; padding:10px 14px; border-radius:8px; background:rgba(15,23,42,0.9); color:#fff; font-weight:700; text-align:center; min-height:48px; display:flex; align-items:center; justify-content:center; }
    .player-controls { display:flex; gap:12px; align-items:center; justify-content:flex-start; flex-wrap:wrap; }
    .btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:8px 12px; border-radius:8px; border:1px solid transparent; cursor:pointer; font-weight:700; text-decoration:none; }
    .btn-play { background:#0f172a; color:#fff; border-color:#0f172a; width:48px; height:48px; border-radius:10px; display:inline-flex; align-items:center; justify-content:center; font-weight:900; }
    .btn-secondary { background:#f8fafc; color:#0f172a; border-color:#e6eef8; }
    .time { color:#6b7280; font-weight:600; font-size:0.95rem; min-width:90px; text-align:left; }
    .volume { display:flex; align-items:center; gap:8px; }
    .progress-mini { height:8px; background:#f1f5f9; border-radius:999px; overflow:hidden; flex:1; }
    .progress-mini > .bar { height:100%; width:0%; background:linear-gradient(90deg,#06b6d4,#3b82f6); transition:width 0.08s linear; }
    .description { color:#374151; line-height:1.6; white-space:pre-wrap; padding:12px; border-radius:8px; background:#fbfdff; border:1px solid #f1f5f9; }
    .transcript-container { max-height:240px; overflow:auto; padding:8px; border-radius:8px; border:1px solid #eef2f7; background:#fff; }
    .transcript-line { padding:6px 8px; border-radius:6px; margin:4px 0; color:#374151; cursor:pointer; }
    .transcript-line.active-transcript { background:linear-gradient(90deg,#e6f6ff,#f0f9ff); color:#0f172a; font-weight:700; box-shadow:0 6px 18px rgba(14,165,233,0.08); }
    @media (max-width:900px) { .podcast-body { flex-direction:column; } .left-col { width:100%; align-items:center; } .thumb { max-width:100%; height:auto; aspect-ratio:1/1; } #waveform { height:120px; } }

