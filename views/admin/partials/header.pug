header.admin-header(role="banner" aria-label="Admin header")
  style.
    .admin-header {
      --ah-bg: #07101a;
      --ah-text: #ffffff;
      --ah-accent: #06b6d4;
      --ah-muted: #9aa4ad;
      --ah-radius: 10px;
      --ah-shadow: 0 10px 30px rgba(2,6,23,0.14);
      --ah-transition: 200ms cubic-bezier(.2,.9,.3,1);
      background: linear-gradient(180deg,var(--ah-bg), #061018);
      color: var(--ah-text);
      padding: 12px 18px;
      position: sticky;
      top: 0;
      z-index: 1200;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: var(--ah-shadow);
      border-bottom: 1px solid rgba(255,255,255,0.03);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .admin-header .container {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .admin-header .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--ah-text);
      font-weight: 700;
      font-size: 20px;
    }
    .admin-header .brand .mark {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: linear-gradient(135deg,var(--ah-accent), #0ea5a4);
      box-shadow: 0 8px 22px rgba(6,182,212,0.12);
      flex: 0 0 36px;
    }
    .admin-header .controls {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .admin-header .btn {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.04);
      padding: 8px;
      border-radius: 10px;
      color: var(--ah-text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: transform var(--ah-transition), background var(--ah-transition);
    }
    .admin-header .btn:hover { background: rgba(255,255,255,0.02); transform: translateY(-2px); }
    .admin-header .search {
      position: relative;
      min-width: 240px;
      max-width: 420px;
    }
    .admin-header .search input {
      width: 100%;
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.06);
      background: rgba(255,255,255,0.03);
      color: var(--ah-text);
      font-size: 14px;
      outline: none;
    }
    .admin-header .search input::placeholder { color: rgba(255,255,255,0.65); }
    .admin-header .search input:focus { box-shadow: 0 8px 24px rgba(6,182,212,0.12); background: rgba(255,255,255,0.04); }
    .admin-header .suggestions {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 8px);
      background: #07101a;
      border-radius: 10px;
      padding: 6px;
      border: 1px solid rgba(255,255,255,0.04);
      box-shadow: var(--ah-shadow);
      display: none;
      z-index: 1400;
      max-height: 240px;
      overflow: auto;
    }
    .admin-header .suggestions.visible { display: block; }
    .admin-header .suggestions li { list-style: none; padding: 8px; border-radius: 8px; color: #eaf6f7; cursor: pointer; }
    .admin-header .suggestions li:hover { background: rgba(255,255,255,0.02); color: var(--ah-accent); }
    .admin-header .user {
      position: relative;
    }
    .admin-header .user .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.04);
    }
    .admin-header .menu {
      position: absolute;
      right: 0;
      top: 56px;
      background: #07101a;
      border-radius: 10px;
      padding: 8px;
      border: 1px solid rgba(255,255,255,0.04);
      box-shadow: var(--ah-shadow);
      display: none;
      z-index: 1500;
      min-width: 200px;
    }
    .admin-header .menu.visible { display: block; }
    .admin-header .menu a { display: block; padding: 8px; border-radius: 8px; color: #eaf6f7; text-decoration: none; }
    .admin-header .menu a:hover { background: rgba(255,255,255,0.02); color: var(--ah-accent); }
    @media (max-width: 720px) {
      .admin-header .search { display: none; }
      .admin-header .brand { font-size: 18px; }
    }

  .container
    a.brand(href="/admin/dashboard" class="brand" title="Trang tổng quan - Admin" rel="home")
      span.mark(aria-hidden="true")
      | ADMIN

    .controls
      button#toggle-sider.btn(type="button" aria-controls="admin-sider" aria-pressed="false" title="Thu/gọn menu")
        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
          path(d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")

      form.search(role="search" action="/admin/search" method="get" onsubmit="return false" aria-label="Tìm kiếm quản trị")
        input(type="search" name="q" placeholder="Tìm kiếm sản phẩm, đơn hàng, tài khoản..." aria-label="Tìm kiếm" autocomplete="off" aria-controls="ah-suggestions" aria-expanded="false")
        ul.suggestions#ah-suggestions(role="listbox" aria-label="Gợi ý tìm kiếm" aria-hidden="true")
          li(role="option" tabindex="-1") Sản phẩm: Áo thun nam
          li(role="option" tabindex="-1") Đơn hàng: #12345
          li(role="option" tabindex="-1") Tài khoản: duy@example.com

      .notif
        button#btn-notif.btn(type="button" aria-haspopup="true" aria-expanded="false" aria-controls="ah-notif" title="Thông báo")
          svg(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            path(d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
          span.badge(aria-hidden="true") 3
        nav#ah-notif.menu(role="menu" aria-hidden="true")
          a(href="#") strong 3 thông báo mới
          hr
          a(href="#") Đơn hàng #12345 đã thanh toán
          a(href="#") Sản phẩm "Áo X" sắp hết hàng

      .user
        button#btn-user.btn(type="button" aria-haspopup="true" aria-expanded="false" aria-controls="ah-user" title="Tài khoản")
          img.avatar(src="/img/user.png" alt="Avatar người dùng")
        nav#ah-user.menu(role="menu" aria-hidden="true")
          a(href="/admin/profile" role="menuitem") Hồ sơ
          a(href="/admin/settings" role="menuitem") Cài đặt
          hr
          a(href="/admin/logout" role="menuitem") Đăng xuất

  script.
    (function(){
      const root = document.querySelector('.admin-header');
      if(!root) return;
      const siderToggle = root.querySelector('#toggle-sider');
      const sider = document.getElementById('admin-sider');
      const searchInput = root.querySelector('.search input');
      const suggestions = root.querySelector('#ah-suggestions');
      const notifBtn = root.querySelector('#btn-notif');
      const notifMenu = root.querySelector('#ah-notif');
      const userBtn = root.querySelector('#btn-user');
      const userMenu = root.querySelector('#ah-user');
      try {
        const collapsed = localStorage.getItem('admin_sider_collapsed') === 'true';
        if(collapsed && sider) sider.classList.add('sider--collapsed');
        if(siderToggle) siderToggle.setAttribute('aria-pressed', collapsed ? 'true' : 'false');
      } catch(e){}
      if(siderToggle && sider){
        siderToggle.addEventListener('click', function(){
          const isCollapsed = sider.classList.toggle('sider--collapsed');
          siderToggle.setAttribute('aria-pressed', isCollapsed ? 'true' : 'false');
          try { localStorage.setItem('admin_sider_collapsed', isCollapsed); } catch(e){}
        });
      }
      if(searchInput && suggestions){
        const items = Array.from(suggestions.querySelectorAll('li'));
        searchInput.addEventListener('input', function(){
          const v = this.value.trim().toLowerCase();
          if(!v){ suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); searchInput.setAttribute('aria-expanded','false'); return; }
          let any = false;
          items.forEach(li => {
            const txt = li.textContent.trim().toLowerCase();
            if(txt.includes(v)){ li.style.display = 'block'; any = true; } else { li.style.display = 'none'; }
          });
          if(any){ suggestions.classList.add('visible'); suggestions.setAttribute('aria-hidden','false'); searchInput.setAttribute('aria-expanded','true'); }
          else { suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); searchInput.setAttribute('aria-expanded','false'); }
        });
        items.forEach(li => li.addEventListener('click', function(){ searchInput.value = this.textContent.trim(); suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); searchInput.setAttribute('aria-expanded','false'); }));
        document.addEventListener('click', function(e){ if(!root.contains(e.target)) { suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); searchInput.setAttribute('aria-expanded','false'); } });
      }
      function toggle(btn, menu){
        if(!btn || !menu) return;
        btn.addEventListener('click', function(e){
          const visible = menu.classList.toggle('visible');
          menu.setAttribute('aria-hidden', visible ? 'false' : 'true');
          btn.setAttribute('aria-expanded', visible ? 'true' : 'false');
          if(menu !== userMenu && userMenu){ userMenu.classList.remove('visible'); userMenu.setAttribute('aria-hidden','true'); if(userBtn) userBtn.setAttribute('aria-expanded','false'); }
          if(menu !== notifMenu && notifMenu){ notifMenu.classList.remove('visible'); notifMenu.setAttribute('aria-hidden','true'); if(notifBtn) notifBtn.setAttribute('aria-expanded','false'); }
        });
      }
      toggle(notifBtn, notifMenu);
      toggle(userBtn, userMenu);
      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape'){
          if(userMenu){ userMenu.classList.remove('visible'); userMenu.setAttribute('aria-hidden','true'); if(userBtn) userBtn.setAttribute('aria-expanded','false'); }
          if(notifMenu){ notifMenu.classList.remove('visible'); notifMenu.setAttribute('aria-hidden','true'); if(notifBtn) notifBtn.setAttribute('aria-expanded','false'); }
          if(suggestions){ suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); if(searchInput) searchInput.setAttribute('aria-expanded','false'); }
        }
      });
      document.addEventListener('click', function(e){
        if(!root.contains(e.target)){
          if(userMenu){ userMenu.classList.remove('visible'); userMenu.setAttribute('aria-hidden','true'); if(userBtn) userBtn.setAttribute('aria-expanded','false'); }
          if(notifMenu){ notifMenu.classList.remove('visible'); notifMenu.setAttribute('aria-hidden','true'); if(notifBtn) notifBtn.setAttribute('aria-expanded','false'); }
          if(suggestions){ suggestions.classList.remove('visible'); suggestions.setAttribute('aria-hidden','true'); if(searchInput) searchInput.setAttribute('aria-expanded','false'); }
        }
      });
    })();
